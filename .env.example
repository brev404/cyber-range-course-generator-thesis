# LLM API Keys
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GOOGLE_API_KEY=your_google_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# LLM Service Defaults (optional)
# Use google for Gemini; default model is gemini-2.5-flash (override with LLM_DEFAULT_MODEL if needed).
# Pipeline reproducibility: fix these for consistent quality across runs (see docs/reference/REPRODUCIBILITY.md)
LLM_DEFAULT_PROVIDER=openai
# LLM_DEFAULT_PROVIDER=google
# LLM_DEFAULT_MODEL=gemini-2.5-flash  # Pin model for reproducibility
# LLM_TEMPERATURE=0  # More deterministic; 0.7 default for variety
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2000
LLM_TIMEOUT=60
# LLM_MAX_CONCURRENT=1
# Set to 4–8 for parallel LLM calls (e.g. Gemini 2.5 Flash Lite 4k RPM)
# LLM_MAX_CONCURRENT=4
# For Anthropic Claude: rate limits are much higher; 5 is a safe starting point.
# LLM_MAX_CONCURRENT=5

# Vector DB / RAG (free local embeddings by default; set EMBEDDING_PROVIDER=openai for OpenAI)
CHROMA_PERSIST_DIR=./data/chroma_db
CHROMA_COLLECTION_NAME=knowledge_base
EMBEDDING_PROVIDER=auto
EMBEDDING_MODEL=text-embedding-3-small
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# RAG: fix for reproducible runs
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200

# Pipeline output (default: true = write generated course to course.md and solve_generated.py; author writeup.md unchanged)
# WRITE_COURSES_TO_DISK=true

# Ranking: overall score threshold; auto-refine (re-run content gen) until all >= this or MAX_REFINEMENT_ROUNDS, then HITL.
# RANKING_PASS_THRESHOLD=9.0
# MAX_REFINEMENT_ROUNDS=5
# Ranking LLM output length (increase if justifications are often truncated)
# RANKING_MAX_TOKENS=4096
# Batch API for ranking (Anthropic only): 50% cost reduction; ~1h latency.
# RANKING_USE_BATCH_API=false
# Ranking judge override: defaults to LLM_DEFAULT_MODEL / LLM_DEFAULT_PROVIDER (i.e. Gemma,
# same model as the generator). Override only to pin a fixed judge across experiments so all
# runs are scored by the same evaluator regardless of which generator model is being tested.
# RANKING_MODEL=google/gemma-4-26b-a4b-it:free  # explicit pin (matches generator default)
# RANKING_PROVIDER=openrouter                    # LangGraph pipeline only
# For the Haiku baseline generator the provider is always the Claude Code CLI (claude -p);
# pass --ranking-model on the CLI there instead.
# Content generation output length (increase for longer course.md / solve scripts)
# CONTENT_GENERATION_MAX_TOKENS=12000
# CONTENT_GENERATION_SOLVE_MAX_TOKENS=3000

# LangSmith Tracing (Optional but recommended)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT="cyber-range-validator"

# Tesseract OCR (Optional, required for OCR functionality in map_official_docs.py)
# If Tesseract is not in your PATH, you might need to specify its full path
# TESSERACT_CMD_PATH=/path/to/tesseract
# If you have custom Tesseract data files, specify their prefix directory
# TESSDATA_PREFIX=/path/to/tessdata

# Terminology validation: block | warn | annotate | off
# TERMINOLOGY_CHECK_MODE=warn

# Discord webhook notification (optional)
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/yyy

# Application Settings
LOG_LEVEL=INFO
DATA_DIR=./data
# SAVE_RUN_CONFIG=true  # Export run config to data/outputs/run_config_latest.json at pipeline start (reproducibility)
